# Spenpy site settings
Options -Indexes

# Always check for a newer version of images/videos, so photos changed in admin.html show immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|mp4|webm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(admin\.html|api\.php)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Private files: never downloadable from the browser
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|database\.sql|setup\.lock|ADMIN-GUIDE\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
